<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stretch_obstacle_grid</name>
  <version>0.0.1</version>
  <description>Cylindrical obstacle grid around Stretch 4's base axis, built from LiDAR frames, for fast dynamic obstacle avoidance</description>
  <maintainer email="support@hello-robot.com">Hello Robot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <build_depend>eigen</build_depend>
  <build_depend>pybind11-dev</build_depend>

  <!-- tools/replay_bag.py also uses stretch_motion_planning (the robot's shapes),
       rosbag2_py, numpy and matplotlib. -->
  <exec_depend>stretch_motion_planning</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
