<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stretch_dynamic_trajectory</name>
  <version>0.0.1</version>
  <description>A FollowJointTrajectory server for Stretch 4 that slows down and stops short for obstacles, using the obstacle grid's check_motion service. Runs inside the Stretch 4 driver.</description>
  <maintainer email="support@hello-robot.com">Hello Robot</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>hello_helpers</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>stretch_motion_planning_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
