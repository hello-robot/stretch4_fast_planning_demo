<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stretch_motion_planning</name>
  <version>0.0.1</version>
  <description>Collision-aware joint trajectory planner for Stretch 4's base rotation, lift, arm and wrist</description>
  <maintainer email="support@hello-robot.com">Hello Robot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>stretch_motion_planning_interfaces</depend>
  <!-- use_obstacle_grid also needs stretch_obstacle_grid at run time (its library and grid tools);
       not declared, since stretch_obstacle_grid depends on this package. -->
  <!-- Also requires the hello-robot-stretch4-kinematics pip package (pinocchio, coal),
       which has no rosdep key. moveit_msgs is optional (for use_planning_scene). -->

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
